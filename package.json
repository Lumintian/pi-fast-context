{
  "name": "pi-fast-context",
  "version": "0.1.0",
  "description": "Pi extension package that registers native Fast Context tools powered by Windsurf Devstral semantic code search.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "fast-context",
    "windsurf",
    "devstral",
    "semantic-search",
    "codebase-search"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justhil/pi-fast-context.git"
  },
  "homepage": "https://github.com/justhil/pi-fast-context#readme",
  "bugs": {
    "url": "https://github.com/justhil/pi-fast-context/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:lib": "node --check src/lib/core.mjs && node --check src/lib/executor.mjs && node --check src/lib/protobuf.mjs && node --check src/lib/directory-scorer.mjs",
    "check": "npm run typecheck && npm run check:lib",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.9",
    "tree-node-cli": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.1 <1",
    "@earendil-works/pi-coding-agent": ">=0.84.1 <1",
    "@earendil-works/pi-tui": ">=0.84.1 <1",
    "typebox": ">=1.3.7 <2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
